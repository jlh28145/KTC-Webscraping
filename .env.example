# Local runtime configuration for KTC Webscraping.
# Copy to .env if you want a reusable shell source file:
#   set -a && source .env && set +a

KTC_DB_PATH=db/ktc.db

# Optional explicit database URL; takes precedence over KTC_DB_PATH.
# sqlite:///path/to.db or postgresql://user:pass@host:5432/dbname (needs the postgres extra).
# Leave blank for the default local SQLite path above.
KTC_DATABASE_URL=

# Only for running the Postgres integration tests locally (use a disposable database;
# the tests drop and recreate ktc_rankings).
# KTC_TEST_POSTGRES_URL=postgresql://ktc:ktc@localhost:5432/ktc_test

# Optional log level for CLI and scraper output.
KTC_LOG_LEVEL=INFO

# Number of ranking pages to scrape (50 rows each).
KTC_PAGE_COUNT=10

# Number of retry attempts after an initial page scrape failure.
KTC_RETRY_ATTEMPTS=2
